#!/bin/sh
# HARNESS MANAGED HOOK: pre-push
# Managed by scripts/harness/hook-install.js. Edit outside the managed markers only.

set -eu

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$ROOT_DIR"

if [ ! -f "scripts/harness/pre-completion.js" ]; then
  echo "harness pre-push: scripts/harness/pre-completion.js not found; skipping"
  exit 0
fi

node scripts/harness/pre-completion.js --target .
